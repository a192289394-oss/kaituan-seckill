# 复制为服务器上的 /opt/uiautomator2-trigger/gateway.env，权限 0600，属主 ubuntu。
# 不要把填好的文件提交进 git（.gitignore 已忽略 gateway.env）。
# 键名以现网 gateway.env 为准；下列是 server/trigger_gateway.py 实际读取的变量。
# 现网文件里若还有别的键，原样保留。值从旧机安全拷贝，不要写进本示例。

# 必填。两个值都要非空，且不能相同。
# GATEWAY_USER_TOKEN 给操作员接口；nginx 若写死了 Bearer，必须与它一致。
# GATEWAY_WORKER_TOKEN 给 /api/worker/*，与 Mac credentials.json 的 worker_token 一致。
GATEWAY_USER_TOKEN=
GATEWAY_WORKER_TOKEN=

# 必填。纯 http(s) origin，不能带路径、query 或 fragment。
# 现网浏览器入口是 https://1.12.208.101/kaituan/ ，路径由 nginx 去掉。
# 本变量实际取值以旧机 gateway.env 为准。
GATEWAY_PUBLIC_ORIGIN=

# 可选。逗号分隔的 Host 白名单。不设则用上面 origin 的主机名。
# GATEWAY_ALLOWED_HOSTS=

# 可选。若设置，进程启动就把网关钉死到这个 worker。
# 现网 Mac 的 --worker-id 是 zhongjiawei-mac-native。
# 不设时，由队列库 meta 里已有的 worker_id 钉死；空库则由第一台连上的 worker 钉死。
# GATEWAY_WORKER_ID=

# 可选。会话 cookie 的 Path。不设则是 / 。以旧机 gateway.env 为准。
# GATEWAY_COOKIE_PATH=
