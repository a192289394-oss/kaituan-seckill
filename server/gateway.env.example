# 复制为服务器上的 /opt/uiautomator2-trigger/gateway.env，权限 0600，属主 ubuntu。
# 不要把填好的文件提交进 git（.gitignore 已忽略 gateway.env）。
# 键名以现网 gateway.env 为准；下列是 server/trigger_gateway.py 实际读取的变量。
# 现网文件里若还有别的键，原样保留。值从旧机安全拷贝，不要写进本示例。

# 必填。两个值都要非空，且不能相同。
# 换服务器时通常原样拷贝，不必因为换机器而轮换。
# 若轮换：nginx 里写死的操作员 Bearer 必须与 GATEWAY_USER_TOKEN 一致；
# Mac credentials.json 的 worker_token 必须与 GATEWAY_WORKER_TOKEN 一致。
GATEWAY_USER_TOKEN=
GATEWAY_WORKER_TOKEN=

# 必填。纯 http(s) origin，不能带路径、query 或 fragment。
# 换服务器时必改：写成新入口的 origin，不要留旧 IP 或旧域名。
# 浏览器路径 /kaituan/ 由 nginx 去掉，不要写进本变量。
GATEWAY_PUBLIC_ORIGIN=

# 换服务器时必改（旧文件里若写过）。逗号分隔的新域名或新 IP。
# 不设则用上面 origin 的主机名。留着旧 Host 时，新入口会被 403。
# GATEWAY_ALLOWED_HOSTS=

# 可选。若设置，进程启动就把网关钉死到这个 worker。
# 现网 Mac 的 --worker-id 是 zhongjiawei-mac-native。换机器不用改这个 id。
# 不设时，由队列库 meta 里已有的 worker_id 钉死；空库则由第一台连上的 worker 钉死。
# GATEWAY_WORKER_ID=

# 换服务器时核对。不设则是 / 。
# 入口仍挂 /kaituan/、网关看到去掉前缀后的 / 时，值经常仍是 / 。
# Path 与新入口不一致时，登录后 gateway_session 带不上。
# GATEWAY_COOKIE_PATH=
