# gateway.env.example — productized self-host sample (NO real secrets)
#
# 1) 新装自填：禁止从任何已有机器拷贝本文件或真实 token。
# 2) 生成命令：python3 -c 'import secrets;print(secrets.token_urlsafe(32))'
# 3) GATEWAY_USER_TOKEN 与 GATEWAY_WORKER_TOKEN 必须非空且互不相同，否则网关拒绝启动。
# 4) GATEWAY_PUBLIC_ORIGIN 只写纯 origin（scheme+host[+port]），不要带 path。
# 5) 独立登录（默认）：操作员在工作台登录面板输入 GATEWAY_USER_TOKEN，换取 gateway_session。
# 6) GATEWAY_COOKIE_PATH 必须与 nginx 路径前缀一致（示例 /kaituan/）。
# 7) GATEWAY_WORKER_ID 强烈建议填写；未填则首个连上的 worker-id 永久绑定，其它 id → 409 worker_pinned。
#
# Copy to gateway.env (chmod 0600). Never commit gateway.env.

GATEWAY_USER_TOKEN=changeme-user-token
GATEWAY_WORKER_TOKEN=changeme-worker-token
GATEWAY_PUBLIC_ORIGIN=https://gateway.example.com
GATEWAY_ALLOWED_HOSTS=gateway.example.com
GATEWAY_COOKIE_PATH=/kaituan/
GATEWAY_WORKER_ID=mac-worker-1

# --- Mac worker catalog (document in AI-INSTALL §7; not a gateway.env key) ---
# catalog.sqlite3 = hotel directory seed DB (table merchant_catalog: entity_id, name, data, updated).
# On first worker start, catalog_from copies it once into worker.sqlite3 (meta catalog_seeded).
# Missing file → empty directory, no crash. Repo has no merchant-*.json → sqlite importer this round;
# new installs must supply a same-schema sqlite (business export/copy).
